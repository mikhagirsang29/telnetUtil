# HTTP listener for the central API
LISTEN_ADDR=:8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=telnet
DB_PASSWORD=change-me
DB_NAME=telnet_central
DB_SSLMODE=disable

# telnetAgent settings (agent listens on 29900 by default)
AGENT_PORT=29900
AGENT_TIMEOUT=15s
MAX_CONCURRENCY=50

# Optional: if set, every request except /healthz must send
# "X-API-Key: <value>" or "Authorization: Bearer <value>"
API_KEY=
